# Hostinger VPS — ExpnsTracker (non usare 80/443/8443 se altri siti li occupano)
HTTP_PORT=8088
# 8443 su 187.126.18.71 è già studioquattrini → default 3443
HTTPS_PORT=3443
# Dentro al container Caddy ascolta sempre :443; la mappa host è HTTPS_PORT.
SITE_ADDRESS=:443
# Con un dominio DNS → IP VPS, Caddy prende Let's Encrypt:
# SITE_ADDRESS=expnstracker.tuodominio.it
# ACME_EMAIL=a.defendi@ddocuments.it
ACME_EMAIL=
# Solo per deploy/docker-compose.https-proxy.yml (app già su :3003):
UPSTREAM=host.docker.internal:3003
