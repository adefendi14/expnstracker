# VPS image: static Next export behind nginx on container :80 (host maps 3003→80).
FROM node:22-bookworm-slim AS build
WORKDIR /app

COPY package.json package-lock.json ./
COPY scripts ./scripts
RUN mkdir -p public && npm ci

COPY . .
# Root basePath (no GitHub Pages prefix)
ENV GITHUB_PAGES=
ARG DEPLOY_SHA=unknown
ENV DEPLOY_SHA=$DEPLOY_SHA
RUN printf '%s\n' "$DEPLOY_SHA" > DEPLOY_SHA.txt \
  && npm run build \
  && cp -f DEPLOY_SHA.txt out/DEPLOY_SHA.txt \
  && printf 'expnstracker-deploy %s\n' "$DEPLOY_SHA" > out/BUILD_MARK.txt

FROM nginx:1.27-alpine
COPY deploy/nginx-spa.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/out /usr/share/nginx/html
EXPOSE 80
